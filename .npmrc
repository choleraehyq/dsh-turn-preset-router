# Publish to the public npm registry.
#
# This overrides the machine-level registry (which may point at a private
# mirror) for every npm command run in this directory, so `npm publish` here
# can never accidentally ship to an internal registry.
#
# It deliberately contains no credentials: authentication comes from
# `npm login`, which writes to the user-level npmrc.
registry=https://registry.npmjs.org/
